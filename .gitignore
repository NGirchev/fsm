/fsm-visual-editor/projects/*.fsm.json
!/fsm-visual-editor/projects/.gitkeep
/.idea/
/.gradle/
/.gradle-local/
/.kotlin/
*.DS_Store

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
!gradle/wrapper/gradle-wrapper.jar
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

